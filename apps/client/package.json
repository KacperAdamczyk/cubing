{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"portless": "cubing",
	"scripts": {
		"dev": "portless run bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "bunx --bun vitest",
		"test": "bunx --bun vitest run --project server",
		"test:e2e": "playwright install && playwright test"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/outfit": "5.3.0",
		"@lucide/svelte": "1.34.0",
		"cube": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.2.0",
		"@vitest/browser-playwright": "4.1.10",
		"daisyui": "5.7.16",
		"db": "workspace:*",
		"playwright": "1.62.1",
		"portless": "0.15.5",
		"svelte": "5.56.8",
		"svelte-check": "4.7.5",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "3.0.0",
		"wrangler": "4.120.0",
		"zod": "4.4.3"
	}
}
